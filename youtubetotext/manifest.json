{
  "manifest_version": 3,
  "name": "rippr",
  "short_name": "rippr",
  "version": "2.0.0",
  "description": "Rip YouTube transcripts to text files — built for RAG and LLM workflows.",
  "permissions": ["activeTab", "declarativeNetRequest"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
