{
  "name": "rippr-mcp",
  "mcpName": "io.github.mrslbt/rippr-mcp",
  "version": "1.3.0",
  "description": "MCP server for ripping YouTube transcripts. Saves each transcript to disk and returns a resource link — persistent artifacts, not ephemeral context. Built for AI agents, RAG pipelines, and LLM workflows.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "rippr-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "test": "node test/integration.test.mjs"
  },
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "ai",
    "rag",
    "llm",
    "claude",
    "model-context-protocol"
  ],
  "author": {
    "name": "Marsel Bait",
    "url": "https://marselbait.me"
  },
  "license": "MIT",
  "homepage": "https://rippr.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrslbt/rippr"
  },
  "bugs": {
    "url": "https://github.com/mrslbt/rippr/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
